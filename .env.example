# Copy to `.env` for local development. In production, set these in the environment.

# The Pxls back end to proxy to (host:port, no protocol, no trailing slash).
NUXT_PROXY_TO=localhost:4567

# Displayed on each page.
NUXT_PUBLIC_TITLE=pxls.space

# Port to listen on (production server). Must differ from the back end's.
PORT=3000
